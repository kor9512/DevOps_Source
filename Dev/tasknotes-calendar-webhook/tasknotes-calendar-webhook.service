[Unit]
Description=Private TaskNotes Google Calendar webhook receiver
After=network-online.target docker.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/data/source/github/oci/tasknotes-calendar-webhook
EnvironmentFile=/home/ubuntu/data/source/github/oci/tasknotes-calendar-webhook/.env
ExecStart=/usr/bin/python3 /home/ubuntu/data/source/github/oci/tasknotes-calendar-webhook/webhook_server.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
